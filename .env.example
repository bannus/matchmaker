# Supabase Configuration
# Get these from your Supabase project: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: force printed QR flyers and other app links to use your public app domain.
# Example: https://matchmaker.bann.us
VITE_APP_URL=https://your-app-domain.com

# ----------------------------------------------------------------------------
# Server-side secrets for the email notification pipeline (NOT used by the
# browser). Set these in production with `supabase secrets set` so they reach
# the Edge Functions:
#
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set RESEND_FROM='Matchmaker <noreply@your-domain>'
#   supabase secrets set APP_URL=https://your-app-domain.com
#   supabase secrets set EMAIL_TRIGGER_SECRET=<random-string>
#   supabase secrets set UNSUBSCRIBE_SECRET=<random-string>
#
# Optional for local/testing only:
#   EMAIL_DELIVERY_MODE=log-only
#
# In the default `resend` mode, RESEND_API_KEY is required. `EMAIL_DELIVERY_MODE`
# should only be set to `log-only` when you intentionally want the function to
# log outbound emails instead of calling Resend.
#
# `EMAIL_TRIGGER_SECRET` and `UNSUBSCRIBE_SECRET` are required anywhere the email
# pipeline is enabled, including local `supabase functions serve`. The edge
# functions fail closed if either secret is missing or empty.
#
# Then point the Postgres trigger at the Edge Functions:
#
#   ALTER DATABASE postgres SET app.settings.edge_functions_url =
#     'https://<project>.supabase.co/functions/v1';
#   ALTER DATABASE postgres SET app.settings.email_trigger_secret =
#     '<must match EMAIL_TRIGGER_SECRET>';
#
# See docs/email-notifications.md for full details.
# ----------------------------------------------------------------------------
